# Copy to .env.local and fill in. Variables are validated in src/env/schema.ts;
# the app does not start if a required one is missing.

# Public URL of the site, without a trailing slash. On Netlify it defaults to
# the deploy URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings > API Keys). Use the new keys, not the
# legacy anon/service_role JWTs. For the local instance, `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional, development only: other hostnames you open `pnpm dev` from (your
# network IP or a tunnel), comma separated, without scheme or port. Without it,
# pages opened from those hosts render but buttons and menus do not work.
# DEV_ALLOWED_ORIGINS=192.168.1.20

# Optional: Google Analytics 4 measurement ID. Set for production in
# netlify.toml; leave it unset locally so tests do not count as visits.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Netlify only (production): Make webhook that posts new articles on the
# social networks (docs/MAKE.md). Read by netlify/functions/announce-posts.mts.
# Leave it unset locally.
# MAKE_WEBHOOK_URL=https://hook.us2.make.com/...

# Contact form (E3-08). Optional: without Turnstile the form is not shown;
# without Resend the lead is saved but no email goes out. For local tests use
# Cloudflare's test keys, which always pass:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# RESEND_API_KEY=re_...
# ADMIN_NOTIFICATION_EMAIL=hola@siete8.com

# Assistant on the site (E10). Optional: without it the chat is not shown.
# Create it in console.anthropic.com > API Keys and set a spending limit there.
# ANTHROPIC_API_KEY=sk-ant-...

# Error monitoring (E7-06). Set only for Netlify's production context, so
# local runs and previews report nothing. To try /dev/sentry locally, set the
# DSN here for a moment.
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# Netlify only, for readable stack traces (source maps uploaded on build):
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=siete8

# Added by later tasks:
# REVALIDATE_SECRET is added with the first on-demand revalidation route.
