# Copy to .env.local and fill in. Variables are validated in src/env/schema.ts;
# the app does not start if a required one is missing.

# Public URL of the site, without a trailing slash. On Netlify it defaults to
# the deploy URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Added by later tasks:
# E1-06 Supabase: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY
# E3-08 Contact form: RESEND_API_KEY, ADMIN_NOTIFICATION_EMAIL, TURNSTILE_SECRET_KEY, NEXT_PUBLIC_TURNSTILE_SITE_KEY
# E7-06 Sentry: NEXT_PUBLIC_SENTRY_DSN, SENTRY_AUTH_TOKEN
# REVALIDATE_SECRET is added with the first on-demand revalidation route.
